@model List<CarritoCompras.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Ropa";
}

<h2 class="mb-4 text-center fw-bold">Tienda de Ropa</h2>

<div class="row">
    @foreach (var producto in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="@producto.ImagenUrl" class="card-img-top" alt="@producto.Nombre" style="height: 220px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fs-6 fw-bold">@producto.Nombre</h5>

                    <div class="mt-auto">
                        <p class="fw-bold text-success fs-5 mb-2">$@producto.Precio.ToString("F2")</p>
                        <form asp-action="AgregarAlCarrito" method="post">
                            <input type="hidden" name="id" value="@producto.Id" />
                            <button type="submit" class="btn btn-primary w-100 fw-bold">
                                Agregar al Carrito
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>