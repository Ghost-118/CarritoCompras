@model IEnumerable<CarritoCompras.Models.ElementoCarrito>

<h2 class="my-4">Tu Carrito de Compras</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        El carrito está vacío. <a asp-action="Index" class="alert-link">Ver catálogo de ropa</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Precio</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="@item.Producto.ImagenUrl" alt="@item.Producto.Nombre" style="width: 50px; height: 50px; object-fit: cover;" class="me-3 rounded" />
                                <span>@item.Producto.Nombre</span>
                            </div>
                        </td>
                        <td>$@item.Producto.Precio</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <form asp-action="DisminuirCantidad" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Producto.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">-</button>
                                </form>
                                <span class="fw-bold px-2">@item.Cantidad</span>
                                <form asp-action="AumentarCantidad" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Producto.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">+</button>
                                </form>
                            </div>
                        </td>
                        <td class="fw-bold">$@item.Subtotal</td>
                        <td>
                            <form asp-action="EliminarDelCarrito" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Producto.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4 p-3 bg-light rounded shadow-sm">
        <a asp-action="Index" class="btn btn-outline-primary">← Seguir Comprando</a>
        <h3 class="mb-0">Total: <span class="text-success fw-bold">$@Model.Sum(i => i.Subtotal)</span></h3>
    </div>
}