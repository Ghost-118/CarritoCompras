<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tienda de Ropa</title>
    <!-- Bootstrap CSS vía CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4 shadow">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4" asp-controller="Tienda" asp-action="Index">👕 Mi Tienda de Ropa</a>
                <div class="navbar-nav ms-auto">
                    <a class="btn btn-outline-light position-relative" asp-controller="Tienda" asp-action="Carrito">
                        🛒 Ver Carrito
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3 mt-5 bg-light">
        <div class="container">
            &copy; 2026 - Mi Tienda de Ropa - ASP.NET Core MVC
        </div>
    </footer>

    <!-- Bootstrap JS vía CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>